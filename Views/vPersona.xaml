<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mmaldonadoS5.Views.vPersona"
             Title="Personas">
    <Grid Padding="16" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Label Grid.Row="0" Text="CRUD de personas" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry Grid.Row="1" x:Name="txtNombre" Placeholder="Ingresa el nombre" MaxLength="25" />
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" x:Name="btnAgregar" Text="Agregar" Clicked="btnAgregar_Clicked" />
            <Button Grid.Column="1" x:Name="btnMostrar" Text="Mostrar" Clicked="btnMostrar_Clicked" />
        </Grid>
        <Label Grid.Row="3" x:Name="lblMessage" TextColor="Red" />
        <CollectionView Grid.Row="4" x:Name="ListaPersonas" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="60,*" RowDefinitions="Auto">
                        <Label Grid.Column="0" Text="{Binding Id, StringFormat='ID: {0}'}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" x:Name="btnActualizar" Text="Actualizar" Clicked="btnActualizar_Clicked" />
            <Button Grid.Column="1" x:Name="btnEliminar" Text="Eliminar" Clicked="btnEliminar_Clicked" BackgroundColor="#B42318" />
        </Grid>
    </Grid>
</ContentPage>
